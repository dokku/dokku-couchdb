#!/usr/bin/env python3
"""Deletes a database made in a service, along with every document in it and
the members it named."""
import base64
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("COUCHDB_HOST", "127.0.0.1")
PORT = os.environ.get("COUCHDB_PORT", "5984")
DATABASE = os.environ["COUCHDB_DATABASE"]
USER = os.environ["COUCHDB_USER"]
PASSWORD = os.environ["COUCHDB_PASSWORD"]


def main():
    url = "http://{}:{}/{}".format(HOST, PORT, urllib.parse.quote(DATABASE, safe=""))
    credentials = base64.b64encode("{}:{}".format(USER, PASSWORD).encode()).decode()
    message = urllib.request.Request(url, headers={"Authorization": "Basic " + credentials}, method="DELETE")

    try:
        with urllib.request.urlopen(message) as response:
            response.read()
    except urllib.error.HTTPError as error:
        # 404 is a database that is already gone
        if error.code != 404:
            sys.stderr.write("unable to destroy {}: {}\n".format(DATABASE, error))
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
