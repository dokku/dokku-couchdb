#!/usr/bin/env python3
"""Creates a database in a service.

The couchdb image creates an admin account from its environment and nothing
else, so the database a linked app is pointed at has to be made once the server
is answering. Creating one that already exists is not an error here: a service
that is recreated keeps the database it had.

A database made beside the service's own is handed the users made in the
service as its members, since couchdb lets no one but an admin into a database
that names none. The service's own account is an admin, and needs nothing.
"""
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("COUCHDB_HOST", "127.0.0.1")
PORT = os.environ.get("COUCHDB_PORT", "5984")
DATABASE = os.environ["COUCHDB_DATABASE"]
USER = os.environ["COUCHDB_USER"]
PASSWORD = os.environ["COUCHDB_PASSWORD"]
MEMBERS = [name for name in os.environ.get("COUCHDB_MEMBERS", "").split() if name != USER]


def request(path, method="GET", body=None):
    url = "http://{}:{}/{}".format(HOST, PORT, path)
    credentials = base64.b64encode("{}:{}".format(USER, PASSWORD).encode()).decode()
    headers = {"Authorization": "Basic " + credentials, "Content-Type": "application/json"}
    data = None if body is None else json.dumps(body).encode()
    message = urllib.request.Request(url, data=data, headers=headers, method=method)

    with urllib.request.urlopen(message) as response:
        return json.load(response)


def main():
    database = urllib.parse.quote(DATABASE, safe="")
    try:
        request(database, method="PUT")
    except urllib.error.HTTPError as error:
        # 412 is couchdb saying the database is already there
        if error.code != 412:
            sys.stderr.write("unable to create {}: {}\n".format(DATABASE, error))
            return 1

    if not MEMBERS:
        return 0

    try:
        security = request(database + "/_security")
        members = security.setdefault("members", {})
        names = members.setdefault("names", [])
        for name in MEMBERS:
            if name not in names:
                names.append(name)
        request(database + "/_security", method="PUT", body=security)
    except urllib.error.HTTPError as error:
        sys.stderr.write("unable to give the users of the service access to {}: {}\n".format(DATABASE, error))
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
