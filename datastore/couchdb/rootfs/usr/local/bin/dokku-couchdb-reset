#!/usr/bin/env python3
"""Deletes every database an app could have written to, and makes the service's
own database again, empty.

The service's account is a server admin, so an app may have made databases of
its own beside the one the service was created with, and those are deleted too.
The databases the server keeps for itself start with an underscore and are left
alone: _users holds accounts and _replicator holds replication jobs, neither of
which is data an app wrote. The admin account itself lives in the server's
configuration rather than in any database.

The databases made in the service with create-database are left alone as well,
since other apps may be linked to them. A reset of one of those, rather than of
the service's own, empties that database alone. Either way the database is made
again with the members it had, so the users made in the service keep their
access to it.
"""
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("COUCHDB_HOST", "127.0.0.1")
PORT = os.environ.get("COUCHDB_PORT", "5984")
DATABASE = os.environ["COUCHDB_DATABASE"]
DEFAULT_DATABASE = os.environ.get("COUCHDB_DEFAULT_DATABASE", DATABASE)
KEEP = set(os.environ.get("COUCHDB_DATABASES", "").split())
USER = os.environ["COUCHDB_USER"]
PASSWORD = os.environ["COUCHDB_PASSWORD"]


def request(path, method="GET", body=None):
    url = "http://{}:{}/{}".format(HOST, PORT, path)
    credentials = base64.b64encode("{}:{}".format(USER, PASSWORD).encode()).decode()
    headers = {"Authorization": "Basic " + credentials, "Content-Type": "application/json"}
    data = None if body is None else json.dumps(body).encode()
    message = urllib.request.Request(url, data=data, headers=headers, method=method)

    with urllib.request.urlopen(message) as response:
        return json.load(response)


def main():
    # a database name may hold a slash, which has to be escaped to stay one
    # path segment rather than becoming a document id
    database = urllib.parse.quote(DATABASE, safe="")
    security = {}
    try:
        security = request(database + "/_security")
    except urllib.error.HTTPError as error:
        if error.code != 404:
            sys.stderr.write("unable to read the members of {}: {}\n".format(DATABASE, error))
            return 1

    names = [DATABASE]
    if DATABASE == DEFAULT_DATABASE:
        names = [name for name in request("_all_dbs") if not name.startswith("_") and (name == DATABASE or name not in KEEP)]

    for name in names:
        try:
            request(urllib.parse.quote(name, safe=""), method="DELETE")
        except urllib.error.HTTPError as error:
            if error.code != 404:
                sys.stderr.write("unable to remove {}: {}\n".format(name, error))
                return 1

    # 412 is a database that already exists, which one made between the
    # listing and here would be
    try:
        request(database, method="PUT")
    except urllib.error.HTTPError as error:
        if error.code != 412:
            sys.stderr.write("unable to create {}: {}\n".format(DATABASE, error))
            return 1

    if security:
        try:
            request(database + "/_security", method="PUT", body=security)
        except urllib.error.HTTPError as error:
            sys.stderr.write("unable to give {} back its members: {}\n".format(DATABASE, error))
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
