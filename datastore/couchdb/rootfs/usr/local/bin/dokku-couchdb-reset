#!/usr/bin/env python3
"""Deletes every database an app could have written to, and makes the service's
own database again, empty.

The service's account is a server admin, so an app may have made databases of
its own beside the one the service was created with, and those are deleted too.
The databases the server keeps for itself start with an underscore and are left
alone: _users holds accounts and _replicator holds replication jobs, neither of
which is data an app wrote. The admin account itself lives in the server's
configuration rather than in any database.
"""
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("COUCHDB_HOST", "127.0.0.1")
PORT = os.environ.get("COUCHDB_PORT", "5984")
DATABASE = os.environ["COUCHDB_DATABASE"]
USER = os.environ["COUCHDB_USER"]
PASSWORD = os.environ["COUCHDB_PASSWORD"]


def request(path, method="GET"):
    url = "http://{}:{}/{}".format(HOST, PORT, path)
    credentials = base64.b64encode("{}:{}".format(USER, PASSWORD).encode()).decode()
    headers = {"Authorization": "Basic " + credentials, "Content-Type": "application/json"}
    message = urllib.request.Request(url, headers=headers, method=method)

    with urllib.request.urlopen(message) as response:
        return json.load(response)


def main():
    # a database name may hold a slash, which has to be escaped to stay one
    # path segment rather than becoming a document id
    for name in request("_all_dbs"):
        if name.startswith("_"):
            continue

        try:
            request(urllib.parse.quote(name, safe=""), method="DELETE")
        except urllib.error.HTTPError as error:
            if error.code != 404:
                sys.stderr.write("unable to remove {}: {}\n".format(name, error))
                return 1

    # 412 is a database that already exists, which one made between the
    # listing and here would be
    try:
        request(urllib.parse.quote(DATABASE, safe=""), method="PUT")
    except urllib.error.HTTPError as error:
        if error.code != 412:
            sys.stderr.write("unable to create {}: {}\n".format(DATABASE, error))
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
