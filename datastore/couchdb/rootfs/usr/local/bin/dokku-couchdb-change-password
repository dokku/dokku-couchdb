#!/usr/bin/env python3
"""Gives the service's admin account a new password.

The account lives in the server's configuration rather than in any database,
and the image only writes it there when the configuration has none, so a new
password is given to the server through its config api. The server hashes it
and writes it back to the file it read the account from, so the new password
outlives a restart and a container made again.
"""
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("COUCHDB_HOST", "127.0.0.1")
PORT = os.environ.get("COUCHDB_PORT", "5984")
USER = os.environ["COUCHDB_USER"]
PASSWORD = os.environ["COUCHDB_PASSWORD"]
NEW_PASSWORD = os.environ["COUCHDB_NEW_PASSWORD"]


def main():
    url = "http://{}:{}/_node/_local/_config/admins/{}".format(HOST, PORT, urllib.parse.quote(USER, safe=""))
    credentials = base64.b64encode("{}:{}".format(USER, PASSWORD).encode()).decode()
    headers = {"Authorization": "Basic " + credentials, "Content-Type": "application/json"}
    message = urllib.request.Request(url, data=json.dumps(NEW_PASSWORD).encode(), headers=headers, method="PUT")

    try:
        with urllib.request.urlopen(message) as response:
            response.read()
    except urllib.error.HTTPError as error:
        sys.stderr.write("unable to change the password of {}: {}\n".format(USER, error))
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
